# Automated Static Analysis (CI/CD) and a Production Readiness Code Review Checklist
# Source code

1. Automated Source Code Inspection (CI/CD)
Integrate automated security, type, and dependency scanners into your pipeline. Add this dedicated workflow to .github/workflows/inspect-code.yml:

name: Source Code Inspection

on:
  pull_request:
    branches: [ main, develop ]

jobs:
  code-inspection:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Inspection Tools
        run: |
          python -m pip install --upgrade pip
          pip install bandit safety mypy flake8 black

      - name: 1. Security Scan (Bandit)
        run: |

          bandit -r app/ -ll

      - name: 2. Dependency CVE Audit (Safety / pip-audit)
        run: |

          safety check -r requirements.txt

      - name: 3. Type Checking & Safety (mypy)
        run: |

          mypy app/ --ignore-missing-imports

      - name: 4. Code Style & Maintainability (Flake8 & Black)
        run: |
          flake8 app/ --max-line-length = 120
          black --check app/
